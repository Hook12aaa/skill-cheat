{
  "schemaVersion": "1.0",
  "rules": [
    {
      "id": "LINT-001",
      "kind": "plugin-policy",
      "description": "Plugin file extensions only .md, .js, .sh, .json",
      "severity": "CRITICAL",
      "detector": {
        "type": "find-extensions",
        "allowlist": [
          ".md",
          ".js",
          ".sh",
          ".json",
          ".cjs",
          ".html",
          ".css",
          ".woff2"
        ],
        "scope": "plugin-root"
      }
    },
    {
      "id": "LINT-002",
      "kind": "skill-shape",
      "description": "Every HARD-GATE sentence opens with an imperative verb",
      "severity": "CRITICAL",
      "detector": {
        "type": "regex-line",
        "section": "hard-gate-blocks",
        "must-match": "^(Do NOT|Never|STOP|NEVER) "
      }
    },
    {
      "id": "LINT-003",
      "kind": "skill-shape",
      "description": "Zero hedge words in SKILL.md body outside references",
      "severity": "CRITICAL",
      "detector": {
        "type": "grep-denylist",
        "source": "references/hedge-words-denylist.json",
        "scope": "skill-body"
      }
    },
    {
      "id": "LINT-004",
      "kind": "skill-shape",
      "description": "Frontmatter description names at least one ALL-CAPS verdict token",
      "severity": "CRITICAL",
      "detector": {
        "type": "yaml-frontmatter",
        "required-fields": [
          "name",
          "description"
        ],
        "description-contains-verdict": true
      }
    },
    {
      "id": "LINT-005",
      "kind": "skill-shape",
      "description": "Zero library or framework names in SKILL.md body",
      "severity": "CRITICAL",
      "detector": {
        "type": "grep-denylist",
        "source": "references/library-names-denylist.json",
        "scope": "skill-body-outside-references"
      }
    },
    {
      "id": "LINT-006",
      "kind": "skill-shape",
      "description": "HARD-GATE content contains no because/since/in-order-to, max 2 sentences",
      "severity": "CRITICAL",
      "detector": {
        "type": "hard-gate-span",
        "max-sentences": 2,
        "forbidden-tokens": [
          "because",
          "since",
          "in order to"
        ]
      }
    },
    {
      "id": "LINT-007",
      "kind": "skill-shape",
      "description": "Gate Functions bullets match 'BEFORE <action>: \"<question>?\"'",
      "severity": "CRITICAL",
      "detector": {
        "type": "regex-line",
        "section": "gate-functions",
        "must-match": "^- BEFORE .+: \".+\\?\"$"
      }
    },
    {
      "id": "LINT-008",
      "kind": "skill-shape",
      "description": "Red Flags bullets are quoted fragments with no em-dash explanation",
      "severity": "CRITICAL",
      "detector": {
        "type": "regex-line",
        "section": "red-flags",
        "must-match": "^- \"",
        "must-not-match": " — "
      }
    },
    {
      "id": "LINT-009",
      "kind": "skill-shape",
      "description": "Bottom Line contains an executable bash/sh fence that passes bash -n",
      "severity": "CRITICAL",
      "detector": {
        "type": "bash-syntax",
        "section": "the-bottom-line"
      }
    },
    {
      "id": "LINT-010",
      "kind": "skill-shape",
      "description": "Section order matches the canonical sequence",
      "severity": "CRITICAL",
      "detector": {
        "type": "section-order",
        "expected-order": [
          "<HARD-GATE>",
          "Anti-Pattern",
          "Core Principle",
          "Process Flow",
          "Checklist",
          "Step Details",
          "Gate Functions",
          "Rationalization Table",
          "Red Flags",
          "Key Principles",
          "The Bottom Line"
        ]
      }
    },
    {
      "id": "LINT-011",
      "kind": "skill-shape",
      "description": "Process Flow dot block parses under dot -Tcanon",
      "severity": "CRITICAL",
      "detector": {
        "type": "dot-parse",
        "section": "process-flow"
      }
    },
    {
      "id": "LINT-012",
      "kind": "skill-shape",
      "description": "Frontmatter has name and description; description names at least one trigger",
      "severity": "CRITICAL",
      "detector": {
        "type": "yaml-frontmatter",
        "required-fields": [
          "name",
          "description"
        ],
        "description-contains-trigger": true
      }
    },
    {
      "id": "LINT-013",
      "kind": "skill-shape",
      "description": "Checklist numbers match Step Details numbered headings 1:1",
      "severity": "CRITICAL",
      "detector": {
        "type": "cross-reference",
        "left-section": "checklist",
        "right-section": "step-details",
        "left-pattern": "^\\d+\\.\\s",
        "right-pattern": "^###\\s+\\d+\\."
      }
    },
    {
      "id": "LINT-014",
      "kind": "skill-shape",
      "description": "No third-person self-reference",
      "severity": "CRITICAL",
      "detector": {
        "type": "grep-denylist",
        "inline-entries": [
          "the skill",
          "this skill",
          "skill deviation",
          "skill mandates"
        ],
        "scope": "skill-body"
      }
    },
    {
      "id": "LINT-015",
      "kind": "skill-shape",
      "description": "Anti-Pattern contains a quoted phrase in its first sentence",
      "severity": "CRITICAL",
      "detector": {
        "type": "regex-line",
        "section": "anti-pattern",
        "first-sentence-must-match": "\".+\""
      }
    },
    {
      "id": "LINT-016",
      "kind": "plugin-policy",
      "description": "HARD-GATE blocks only inside Integrity Block or rendered SKILL.md, not in design.md editable region",
      "severity": "CRITICAL",
      "detector": {
        "type": "grep-required",
        "pattern": "design-region-clean-of-hard-gates",
        "scope": "design-editable-region"
      }
    },
    {
      "id": "LINT-017",
      "kind": "skill-shape",
      "description": "HARD-GATE 'Do NOT' sentences carry a precondition keyword (without/if/until/outside/unless)",
      "severity": "CRITICAL",
      "detector": {
        "type": "regex-line",
        "section": "hard-gate-blocks",
        "must-match": "^(Do NOT\\b.*\\b(without|if|until|outside|unless)\\b|Never |STOP |NEVER )"
      }
    },
    {
      "id": "LINT-018",
      "kind": "skill-shape",
      "description": "HARD-GATE body contains at least one STOP or NEVER fail-action sentence",
      "severity": "CRITICAL",
      "detector": {
        "type": "hard-gate-span",
        "required-fail-pattern": "^(STOP |NEVER )"
      }
    },
    {
      "id": "LINT-019",
      "kind": "skill-shape",
      "description": "Rationalization Table Reality cells contain an imperative counter",
      "severity": "CRITICAL",
      "detector": {
        "type": "rationalization-table-cells",
        "source": "references/imperative-verbs-allowlist.json"
      }
    },
    {
      "id": "LINT-020",
      "kind": "skill-shape",
      "description": "Soft hedge words in SKILL.md body (context-dependent; voice-reviewer judgment)",
      "severity": "IMPORTANT",
      "detector": {
        "type": "grep-denylist",
        "source": "references/hedge-words-denylist.json",
        "field": "warnings",
        "scope": "skill-body"
      }
    },
    {
      "id": "LINT-021",
      "kind": "skill-shape",
      "description": "Domain library names in SKILL.md body (may be the skill's subject; voice-reviewer judgment)",
      "severity": "IMPORTANT",
      "detector": {
        "type": "grep-denylist",
        "source": "references/library-names-denylist.json",
        "field": "warnings",
        "scope": "skill-body-outside-references"
      }
    }
  ]
}
