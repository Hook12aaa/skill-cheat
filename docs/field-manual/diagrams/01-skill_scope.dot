digraph skill_scope {
    bgcolor="white";
    fontname="Helvetica";
    rankdir=LR;
    ranksep=0.55;
    nodesep=0.35;
    node [fontname="Helvetica", fontsize=11, style="filled", fillcolor="#f3f4f6", color="#374151", penwidth=1.3, shape=box, height=0.55];
    edge [fontname="Helvetica", fontsize=10, color="#6b7280", arrowsize=0.8, penwidth=1.2];

    "Intent received" [fillcolor="#dbeafe", color="#1d4ed8"];
    "Ask name + command";
    "Ask triggers + verdicts";
    "Ask Anti-Pattern phrase";
    "Ask target project path";
    "Ask new plugin or existing?";
    "Write scope.md";
    "SCOPE_LOCKED" [shape=doublecircle, fillcolor="#dcfce7", color="#15803d", fontsize=10];

    { rank=same; "Intent received"; "Ask target project path"; }
    { rank=same; "Ask name + command"; "Ask new plugin or existing?"; }
    { rank=same; "Ask triggers + verdicts"; "Write scope.md"; }
    { rank=same; "Ask Anti-Pattern phrase"; "SCOPE_LOCKED"; }

    "Intent received" -> "Ask name + command";
    "Ask name + command" -> "Ask triggers + verdicts";
    "Ask triggers + verdicts" -> "Ask Anti-Pattern phrase";
    "Ask Anti-Pattern phrase" -> "Ask target project path";
    "Ask target project path" -> "Ask new plugin or existing?";
    "Ask new plugin or existing?" -> "Write scope.md";
    "Write scope.md" -> "SCOPE_LOCKED";
}
